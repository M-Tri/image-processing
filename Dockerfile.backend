FROM node:20-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    pkg-config \
    libeigen3-dev \
    libopencv-dev \
    libtesseract-dev \
    libleptonica-dev \
    tesseract-ocr \
    tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*

COPY solver/ /app/solver/

RUN cmake -S solver -B solver/build \
    && cmake --build solver/build -j$(nproc)

WORKDIR /app/backend

COPY backend/package*.json ./
RUN npm install

COPY backend/src ./src
RUN mkdir -p uploads processed

ENV SOLVER_PATH=/app/solver/build/ocr-equation-solver
ENV TESSDATA_PATH=/usr/share/tesseract-ocr/5/tessdata
ENV PORT=5001
ENV FRONTEND_ORIGIN=http://localhost:5173

EXPOSE 5001

CMD ["npm", "start"]
